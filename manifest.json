{
  "manifest_version": 3,
  "name": "HuskySync",
  "version": "0.1.0",
  "description": "See your HuskyCT deadlines at a glance and add them to Google Calendar and Google Tasks.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "identity"],
  "host_permissions": ["https://lms.uconn.edu/*"],
  "optional_host_permissions": ["https://*/*"],
  "oauth2": {
    "client_id": "506796942408-9t6rh4ftqm8ipbunsnav4vitiodl0ci7.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/tasks"
    ]
  }
}
